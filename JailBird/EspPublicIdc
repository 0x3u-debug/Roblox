local VALID_PARTS = {
    "Head", "Torso", "HumanoidRootPart", "Left Arm", "Right Arm", "Left Leg", "Right Leg",
    "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand",
    "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg",
    "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"
}

local function isValidPart(part)
    if not part:IsA("BasePart") then return false end
    for _, name in ipairs(VALID_PARTS) do if part.Name == name then return true end end
    return false
end

local function cacheCharacterParts(player, character)
    local parts = {}
    for _, part in ipairs(character:GetDescendants()) do if isValidPart(part) then table.insert(parts, part) end end
    partRegistry[player] = parts
    character.DescendantAdded:Connect(function(part) if isValidPart(part) then table.insert(partRegistry[player], part) end end)
end

local function getHighestBarOffset(side)
    local maxOffset = 0
    if not EspLibLink.Drawing.Bars then return 0 end
    for _, barConfig in pairs(EspLibLink.Drawing.Bars) do
        if barConfig.Enabled and barConfig.Side == side then
            local current = (barConfig.Offset or 0) + (barConfig.Thickness or 2)
            if current > maxOffset then maxOffset = current end
        end
    end
    return maxOffset
end

local function buildSeamlessColorSequence(gradConfig)
    local colors = {}
    local i = 1
    while gradConfig["Gradient" .. i] ~= nil do
        table.insert(colors, gradConfig["Gradient" .. i])
        i = i + 1
    end
    
    local count = #colors
    if count == 0 then
        return ColorSequence.new(Color3.fromRGB(255, 255, 255))
    elseif count == 1 then
        return ColorSequence.new(colors[1])
    else
        local keypoints = {}
        for idx, col in ipairs(colors) do
            local timeVal = (idx - 1) / (count - 1)
            table.insert(keypoints, ColorSequenceKeypoint.new(timeVal, col))
        end
        return ColorSequence.new(keypoints)
    end
end

local function evaluateCustomGradientColor(gradConfig, ratio)
    local colors = {}
    local i = 1
    while gradConfig["Gradient" .. i] ~= nil do
        table.insert(colors, gradConfig["Gradient" .. i])
        i = i + 1
    end
    
    local count = #colors
    if count == 0 then return Color3.fromRGB(255, 255, 255) end
    if count == 1 then return colors[1] end
    
    local clampedRatio = math.clamp(ratio, 0, 1)
    if clampedRatio == 1 then return colors[count] end
    
    local scaled = clampedRatio * (count - 1)
    local index = math.floor(scaled) + 1
    local alpha = scaled - (index - 1)
    
    local c1 = colors[index]
    local c2 = colors[index + 1] or c1
    return c1:Lerp(c2, alpha)
end

local function createBoxUI(player)
    local container = createElement("Frame", { BackgroundTransparency = 1, Visible = false, Name = player.Name }, ESPGui)
    
    local glowImg = createElement("ImageLabel", { Parent = container, Name = "GlowImage", ImageColor3 = Color3.fromRGB(255, 255, 255), ScaleType = Enum.ScaleType.Slice, ImageTransparency = 0.9, BorderColor3 = Color3.fromRGB(0, 0, 0), BackgroundColor3 = Color3.fromRGB(255, 255, 255), Image = "http://www.roblox.com/asset/?id=18245826428", BackgroundTransparency = 1, Position = UDim2.new(0, -20, 0, -20), Size = UDim2.new(1, 40, 1, 40), ZIndex = 0, BorderSizePixel = 0, SliceCenter = Rect.new(Vector2.new(21, 21), Vector2.new(79, 79)), Visible = false })
    local outerBlack = createElement("Frame", { Size = UDim2.new(1, 2, 1, 2), Position = UDim2.new(0, -1, 0, -1), BackgroundTransparency = 1, ZIndex = 1 }, container)
