    local mainStroke = createStroke(Color3.fromRGB(255, 255, 255), mainWhite)
    local innerBlack = createElement("Frame", { Size = UDim2.new(1, -2, 1, -2), Position = UDim2.new(0, 1, 0, 1), BackgroundTransparency = 1, ZIndex = 3 }, container)
    createStroke(Color3.fromRGB(0, 0, 0), innerBlack)
    
    createElement("TextLabel", { Name = "NameText", Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0, -3), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 255, 255), TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(0, 0, 0), FontFace = customFont, TextSize = 12, AutomaticSize = Enum.AutomaticSize.XY, Text = player.Name, ZIndex = 5 }, container)
    createElement("TextLabel", { Name = "DistanceText", Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 1, 2), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 255, 255), TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(0, 0, 0), FontFace = customFont, TextSize = 12, AutomaticSize = Enum.AutomaticSize.XY, Text = "0m", ZIndex = 5 }, container)
    
    local barsFolder = createElement("Folder", { Name = "BarsFolder" }, container)
    for _, barConfig in pairs(EspLibLink.Drawing.Bars or {}) do
        local bar = createElement("Frame", { Name = barConfig.Name, BackgroundColor3 = Color3.fromRGB(0, 0, 0), BorderSizePixel = 1, BorderColor3 = Color3.fromRGB(0, 0, 0), ZIndex = 2, ClipsDescendants = true }, barsFolder)
        bar:SetAttribute("LastValue", -1)
        
        local fill = createElement("Frame", { Name = "Fill", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = barConfig.Color or Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, ZIndex = 3 }, bar)
        
        local gradCfg = barConfig.Gradient
        if type(gradCfg) == "table" and gradCfg.Enabled then
            fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            createElement("UIGradient", { Name = "Grad", Rotation = 90, Color = buildSeamlessColorSequence(gradCfg), Offset = Vector2.new(0, 0) }, fill)
        end
        
        createElement("TextLabel", { Name = "ValueText", Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 255, 255), TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(0, 0, 0), FontFace = customFont, TextSize = 12, AutomaticSize = Enum.AutomaticSize.XY, Text = "0", ZIndex = 5, Visible = false }, bar)
    end

    playerBoxes[player] = { Container = container, GlowImage = glowImg, MainStroke = mainStroke, BarsFolder = barsFolder }
end

local function setupPlayer(player)
    if player == LocalPlayer and not DEBUG_MODE then return end
    createBoxUI(player)
    player.CharacterAdded:Connect(function(character) cacheCharacterParts(player, character) displayedValues[player] = nil end)
    if player.Character then cacheCharacterParts(player, player.Character) end
end

local function removePlayer(player)
    if playerBoxes[player] then playerBoxes[player].Container:Destroy(); playerBoxes[player] = nil end
    partRegistry[player] = nil; displayedValues[player] = nil
end

for _, player in ipairs(Players:GetPlayers()) do setupPlayer(player) end
Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(removePlayer)

local function getBoundingBox(parts)
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local anyOnScreen = false
    for _, part in ipairs(parts) do
        local cf, size = part.CFrame, part.Size
        local corners = { (cf * CFrame.new(size.X/2, size.Y/2, size.Z/2)).Position, (cf * CFrame.new(-size.X/2, size.Y/2, size.Z/2)).Position, (cf * CFrame.new(size.X/2, -size.Y/2, size.Z/2)).Position, (cf * CFrame.new(-size.X/2, -size.Y/2, size.Z/2)).Position, (cf * CFrame.new(size.X/2, size.Y/2, -size.Z/2)).Position, (cf * CFrame.new(-size.X/2, size.Y/2, -size.Z/2)).Position, (cf * CFrame.new(size.X/2, -size.Y/2, -size.Z/2)).Position, (cf * CFrame.new(-size.X/2, -size.Y/2, -size.Z/2)).Position }
        for _, corner in ipairs(corners) do
            local screenPos, onScreen = Camera:WorldToViewportPoint(corner)
            if onScreen then anyOnScreen = true end
            if screenPos.Z > 0 then minX = math.min(minX, screenPos.X); minY = math.min(minY, screenPos.Y); maxX = math.max(maxX, screenPos.X); maxY = math.max(maxY, screenPos.Y) end
        end
    end
    if anyOnScreen and minX ~= math.huge then return true, Vector2.new(minX, minY), Vector2.new(maxX - minX, maxY - minY) end
    return false, nil, nil
end

local gradientAnimTime = 0

local function createSmoothGradient(color1, color2)
    return ColorSequence.new({ ColorSequenceKeypoint.new(0, color1), ColorSequenceKeypoint.new(1, color2) })
end

RunService.RenderStepped:Connect(function(dt)
    gradientAnimTime = gradientAnimTime + dt
    for player, data in pairs(playerBoxes) do
        local character = player.Character
        local parts = partRegistry[player]
        local root = character and character:FindFirstChild("HumanoidRootPart")
        
        local shouldShow = true
        if EspLibLink.Drawing.Box.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
            shouldShow = false
        end

        if shouldShow and character and parts and #parts > 0 and root and root.Parent then
            local _, rootOnScreen = Camera:WorldToViewportPoint(root.Position)
            if rootOnScreen and EspLibLink.Drawing.Box.Enabled then
                local bSuccess, pos, size = getBoundingBox(parts)
                if bSuccess then
                    local container = data.Container
                    container.Size = UDim2.new(0, math.floor(size.X), 0, math.floor(size.Y))
                    container.Position = UDim2.new(0, math.floor(pos.X), 0, math.floor(pos.Y))
                    container.Visible = true
                    
                    local topOffset = getHighestBarOffset("Top")
                    local bottomOffset = getHighestBarOffset("Bottom")
                    
                    local nameText = container:FindFirstChild("NameText")
                    if nameText then
                        if topOffset > 0 then
                            nameText.Position = UDim2.new(0.5, 0, 0, -3 - topOffset)
                        else
                            nameText.Position = UDim2.new(0.5, 0, 0, -3)
                        end
                    end
                    
                    local distanceText = container:FindFirstChild("DistanceText")
                    if distanceText then
                        if bottomOffset > 0 then
                            distanceText.Position = UDim2.new(0.5, 0, 1, 2 + bottomOffset)
                        else
                            distanceText.Position = UDim2.new(0.5, 0, 1, 2)
                        end
                    end
                    
                    local localChar = LocalPlayer.Character
                    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
                    if localRoot then distanceText.Text = math.floor((localRoot.Position - root.Position).Magnitude) .. "m" end
                    
                    local gradientConfig = EspLibLink.Drawing.Box.Gradient
                    if gradientConfig.Enabled then
                        local strokeGradient = data.MainStroke:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
                        strokeGradient.Color = createSmoothGradient(gradientConfig.Color1, gradientConfig.Color2)
                        strokeGradient.Rotation = gradientConfig.Animated and ((gradientAnimTime * gradientConfig.Speed * 360) % 360) or 45
                        if not strokeGradient.Parent then strokeGradient.Parent = data.MainStroke end
                        data.MainStroke.Color = Color3.fromRGB(255, 255, 255)
                    else
                        local grad = data.MainStroke:FindFirstChildOfClass("UIGradient")
                        if grad then grad:Destroy() end
                        data.MainStroke.Color = Color3.fromRGB(255, 255, 255)
                    end
                    
                    local glowConfig = EspLibLink.Drawing.Box.Glow
                    data.GlowImage.Visible = glowConfig.Enabled
                    if glowConfig.Enabled then
                        data.GlowImage.ImageColor3 = glowConfig.Color
                        data.GlowImage.ImageTransparency = glowConfig.Transparency 
                    end
                    
                    if not displayedValues[player] then displayedValues[player] = {} end
                    
                    for _, barConfig in pairs(EspLibLink.Drawing.Bars or {}) do
                        local bar = data.BarsFolder:FindFirstChild(barConfig.Name)
                        if bar then
                            bar.Visible = barConfig.Enabled
                            if barConfig.Enabled then
                                local t = barConfig.Thickness or 2
                                local off = barConfig.Offset or 5
                                local side = barConfig.Side or "Left"
                                
                                if side == "Left" then
                                    bar.Size = UDim2.new(0, t, 1, 2)
                                    bar.Position = UDim2.new(0, -off - t, 0, -1)
                                elseif side == "Right" then
                                    bar.Size = UDim2.new(0, t, 1, 2)
                                    bar.Position = UDim2.new(1, off, 0, -1)
                                elseif side == "Top" then
                                    bar.Size = UDim2.new(1, 2, 0, t)
                                    bar.Position = UDim2.new(0, -1, 0, -off - t)
                                elseif side == "Bottom" then
                                    bar.Size = UDim2.new(1, 2, 0, t)
                                    bar.Position = UDim2.new(0, -1, 1, off)
                                end
                                
                                local currentVal = barConfig.Values and barConfig.Values.Current or 100
                                local maxVal = barConfig.Values and barConfig.Values.Max or 100
                                local lastVal = bar:GetAttribute("LastValue")
                                
                                if not displayedValues[player][barConfig.Name] then displayedValues[player][barConfig.Name] = currentVal else displayedValues[player][barConfig.Name] = displayedValues[player][barConfig.Name] + (currentVal - displayedValues[player][barConfig.Name]) * math.clamp(dt * 15, 0, 1) end
                                
                                local currentDisplayVal = displayedValues[player][barConfig.Name]
                                local ratio = math.clamp(currentVal / maxVal, 0, 1)
                                
                                local gradCfg = barConfig.Gradient
                                local textColor = Color3.fromRGB(255, 255, 255)
                                local fill = bar:FindFirstChild("Fill")
                                local valueText = bar:FindFirstChild("ValueText")
                                
                                if type(gradCfg) == "table" and gradCfg.Enabled then
                                    textColor = evaluateCustomGradientColor(gradCfg, ratio)
                                    if fill then
                                        fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                                        local uig = fill:FindFirstChildOfClass("UIGradient")
                                        if not uig then
                                            uig = Instance.new("UIGradient", fill)
                                            uig.Name = "Grad"
                                        end
                                        
                                        local isHorizontal = (side == "Top" or side == "Bottom")
                                        uig.Rotation = isHorizontal and 0 or 90
                                        uig.Color = buildSeamlessColorSequence(gradCfg)
                                        uig.Offset = Vector2.new(0, 0)
                                    end
                                else
                                    if fill then
                                        fill.BackgroundColor3 = barConfig.Color or Color3.fromRGB(255, 255, 255)
                                        local uig = fill:FindFirstChildOfClass("UIGradient")
                                        if uig then uig:Destroy() end
                                    end
                                    textColor = barConfig.Color or Color3.fromRGB(255, 255, 255)
                                end
                                
                                if fill and valueText then
                                    if currentVal ~= lastVal then
                                        bar:SetAttribute("LastValue", currentVal)
                                        local targetSize, targetPos
                                        if side == "Left" or side == "Right" then
                                            if barConfig.Inverted then
                                                targetSize = UDim2.new(1, 0, ratio, 0)
                                                targetPos = UDim2.new(0, 0, 0, 0)
                                            else
                                                targetSize = UDim2.new(1, 0, ratio, 0)
                                                targetPos = UDim2.new(0, 0, 1 - ratio, 0)
                                            end
                                        else
                                            if barConfig.Inverted then
                                                targetSize = UDim2.new(ratio, 0, 1, 0)
                                                targetPos = UDim2.new(1 - ratio, 0, 0, 0)
                                            else
                                                targetSize = UDim2.new(ratio, 0, 1, 0)
                                                targetPos = UDim2.new(0, 0, 0, 0)
                                            end
                                        end
                                        TweenService:Create(fill, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = targetSize, Position = targetPos }):Play()
                                    end
                                    
                                    if barConfig.ShowText then
                                        local format = barConfig.TextFormat or "Value"
                                        local textStr = tostring(math.floor(currentDisplayVal + 0.5))
                                        if format == "Percentage" then
                                            textStr = math.floor((currentDisplayVal / maxVal) * 100 + 0.5) .. "%"
                                        elseif format == "Fraction" then
                                            textStr = math.floor(currentDisplayVal + 0.5) .. "/" .. math.floor(maxVal + 0.5)
                                        end
                                        valueText.Text = textStr
                                        
                                        if barConfig.HideWhenMax then
                                            valueText.Visible = currentVal < maxVal
                                        else
                                            valueText.Visible = true
                                        end
                                        
                                        valueText.TextColor3 = textColor
                                        
                                        if side == "Left" then
                                            valueText.AnchorPoint = Vector2.new(1, 0)
                                            valueText.Position = UDim2.new(0, -3, 0, math.floor(bar.AbsoluteSize.Y * (1 - ratio)) - 2)
                                        elseif side == "Right" then
                                            valueText.AnchorPoint = Vector2.new(0, 0)
                                            valueText.Position = UDim2.new(1, 3, 0, math.floor(bar.AbsoluteSize.Y * (1 - ratio)) - 2)
                                        else
                                            valueText.AnchorPoint = Vector2.new(0.5, 1)
                                            valueText.Position = UDim2.new(ratio, 0, 0, -2)
                                        end
                                    else
                                        valueText.Visible = false
                                    end
                                end
                            end
                        end
                    end
                    continue
                end
            end
        end
        data.Container.Visible = false
        displayedValues[player] = nil
    end
end)

return EspLibLink
