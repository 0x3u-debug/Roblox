	preview:slider({name = "Live Value", flag = "demo_live", min = 0, max = 100, default = 50, interval = 1, callback = function(value)
		status.set("Live Value: " .. value)
	end})

	preview:dropdown({name = "Preview Mode", flag = "demo_preview_mode", items = {"Box", "Corner", "Outline"}})

	preview:button_holder({})
	preview:button({name = "Reset Accent", callback = function()
		library:update_theme("accent", hex("#6078BE"))
	end})

	library:notification({text = "atlanta loaded", time = 4})
end

return library, themes
