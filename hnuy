		local moved = false
		local origin
		local anchor

		mobile_button.InputBegan:Connect(function(input)
			if is_press(input) then
				held = true
				moved = false
				origin = input.Position
				anchor = mobile_button.Position
			end
		end)

		library:connection(uis.InputChanged, function(input)
			if held and is_move(input) then
				local dx = input.Position.X - origin.X
				local dy = input.Position.Y - origin.Y

				if abs(dx) > 6 or abs(dy) > 6 then
					moved = true
				end

				local wide, tall = usable_area()

				mobile_button.Position = dim2(
					0, clamp(anchor.X.Offset + dx, 0, wide - mobile_button.AbsoluteSize.X),
					0, clamp(anchor.Y.Offset + dy, 0, tall - mobile_button.AbsoluteSize.Y)
				)
			end
		end)

		library:connection(uis.InputEnded, function(input)
			if held and is_press(input) then
				held = false

				if not moved then
					window.set_menu_visibility(not window.opened)
				end
			end
		end)
