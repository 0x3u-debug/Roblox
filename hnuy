function library:group(options)
	options = options or {}

	local cfg = {
		parent = options.parent or ((self.flag and self.set) and self or nil),
		value = options.value,
		invert = options.invert or false,
		line = options.line ~= false,
		indent = options.indent or 14,
		opened = false,
		transitioning = false,
	}

	local holder = (cfg.parent and cfg.parent.holder) or self.holder

	local wrapper = library:create("Frame", {
		Parent = holder,
		Name = "\0",
		BackgroundTransparency = 1,
		BorderColor3 = rgb(0, 0, 0),
		Position = dim2(0, 0, 0, 0),
		Size = dim2(1, -8, 0, 0),
		ClipsDescendants = true,
		BorderSizePixel = 0,
		Visible = false,
		BackgroundColor3 = rgb(255, 255, 255)
	})

	local line
	if cfg.line then
		line = library:create("Frame", {
			Parent = wrapper,
			Name = "\0",
			Position = dim2(0, 7, 0, 0),
			BorderColor3 = rgb(0, 0, 0),
			Size = dim2(0, 1, 1, -4),
			BorderSizePixel = 0,
			BackgroundTransparency = 1,
			BackgroundColor3 = themes.preset.inline
		}) library:apply_theme(line, "inline", "BackgroundColor3")
	end

	local elements = library:create("Frame", {
		Parent = wrapper,
		Name = "\0",
		BackgroundTransparency = 1,
		Position = dim2(0, cfg.indent, 0, 0),
		BorderColor3 = rgb(0, 0, 0),
		Size = dim2(1, -cfg.indent, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
		BackgroundColor3 = rgb(255, 255, 255)
	})

	local layout = library:create("UIListLayout", {
		Parent = elements,
		Padding = dim(0, 4),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder
	})

	cfg.holder = elements

	local function target_height()
		return layout.AbsoluteContentSize.Y + 4
	end

	library:connection(layout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
		if cfg.opened and not cfg.transitioning then
			wrapper.Size = dim2(1, -8, 0, target_height())
		end
	end)

	function cfg.set_visible(state)
		local visible

		if cfg.value ~= nil then
			if type(state) == "table" then
				visible = find(state, cfg.value) ~= nil
			else
				visible = state == cfg.value
			end
		else
			visible = state and true or false
		end

		if cfg.invert then
			visible = not visible
		end

		if cfg.opened == visible then
			return
		end

		cfg.opened = visible
		cfg.transitioning = true

		if visible then
			wrapper.Visible = true
			wrapper.Size = dim2(1, -8, 0, 0)
			elements.Position = dim2(0, cfg.indent - 6, 0, 0)

			library:tween(wrapper, {Size = dim2(1, -8, 0, target_height())})
			library:tween(elements, {Position = dim2(0, cfg.indent, 0, 0)})

			if line then
				library:tween(line, {BackgroundTransparency = 0})
			end
		else
			library:tween(wrapper, {Size = dim2(1, -8, 0, 0)})
			library:tween(elements, {Position = dim2(0, cfg.indent - 6, 0, 0)})

			if line then
				library:tween(line, {BackgroundTransparency = 1})
			end
		end

		task.delay(0.25, function()
			cfg.transitioning = false

			if cfg.opened then
				wrapper.Size = dim2(1, -8, 0, target_height())
			else
				wrapper.Visible = false
			end
		end)
	end

	if cfg.parent then
		cfg.parent.dependents = cfg.parent.dependents or {}
		insert(cfg.parent.dependents, cfg.set_visible)

		local current = flags[cfg.parent.flag]

		if type(current) == "table" and current.active ~= nil then
			current = current.active
		end

		task.defer(function()
			cfg.set_visible(current)

			if cfg.opened then
				cfg.transitioning = false
				wrapper.Size = dim2(1, -8, 0, target_height())
			end
		end)
	end

	return setmetatable(cfg, library)
end

