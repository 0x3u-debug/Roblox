			AutomaticSize = Enum.AutomaticSize.Y,
			TextSize = library.text_size,
			BackgroundColor3 = rgb(255, 255, 255)
		})

		library:apply_theme(TextButton, "accent", "TextColor3")

		local UIStroke = library:create("UIStroke", {
