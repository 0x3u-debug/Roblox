local function is_press(input)
	local kind = input.UserInputType

	return kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch
end

local function is_move(input)
	local kind = input.UserInputType

	return kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch
end

local function usable_area()
	local viewport = camera.ViewportSize

	return viewport.X, viewport.Y - gui_service:GetGuiInset().Y
end

local function fit_to_screen(x, y, size_x, size_y)
	local wide, tall = usable_area()

	return dim2(
		0, clamp(x, 4, max(4, wide - size_x - 4)),
		0, clamp(y, 4, max(4, tall - size_y - 4))
	)
end

