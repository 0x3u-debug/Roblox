    ["LeftFoot"] = true, ["RightUpperLeg"] = true, ["RightLowerLeg"] = true, ["RightFoot"] = true
}

local function isValidPart(part)
    return part:IsA("BasePart") and VALID_PARTS[part.Name] or false
end

local function cacheCharacterParts(player, character)
    local parts = {}
    for _, part in ipairs(character:GetDescendants()) do if isValidPart(part) then table.insert(parts, part) end end
    partRegistry[player] = parts
    character.DescendantAdded:Connect(function(part) if isValidPart(part) then table.insert(partRegistry[player], part) end end)
end

local function getHighestBarOffset(side)
    local maxOffset = 0
    if not EspLibLink.Drawing.Bars then return 0 end
    for _, barConfig in pairs(EspLibLink.Drawing.Bars) do
        if barConfig.Enabled and barConfig.Side == side then
            local current = (barConfig.Offset or 0) + (barConfig.Thickness or 2)
            if current > maxOffset then maxOffset = current end
        end
    end
    return maxOffset
end

local function buildSeamlessColorSequence(gradConfig)
    local colors = {}
    local i = 1
    while gradConfig["Gradient" .. i] ~= nil do
        table.insert(colors, gradConfig["Gradient" .. i])
        i = i + 1
    end
    
    local count = #colors
    if count == 0 then
        return ColorSequence.new(Color3_fromRGB(255, 255, 255))
    elseif count == 1 then
        return ColorSequence.new(colors[1])
    else
        local keypoints = {}
        for idx, col in ipairs(colors) do
            local timeVal = (idx - 1) / (count - 1)
            table.insert(keypoints, ColorSequenceKeypoint.new(timeVal, col))
        end
        return ColorSequence.new(keypoints)
    end
end

local function evaluateCustomGradientColor(gradConfig, ratio)
    local colors = {}
    local i = 1
    while gradConfig["Gradient" .. i] ~= nil do
        table.insert(colors, gradConfig["Gradient" .. i])
        i = i + 1
    end
    
    local count = #colors
    if count == 0 then return Color3_fromRGB(255, 255, 255) end
    if count == 1 then return colors[1] end
    
    local clampedRatio = math_clamp(ratio, 0, 1)
    if clampedRatio == 1 then return colors[count] end
    
    local scaled = clampedRatio * (count - 1)
    local index = math_floor(scaled) + 1
    local alpha = scaled - (index - 1)
    
    local c1 = colors[index]
    local c2 = colors[index + 1] or c1
    return c1:Lerp(c2, alpha)
end

