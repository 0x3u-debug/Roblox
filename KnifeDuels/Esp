local function getBoundingBox(parts)
    local minX, minY, maxX, maxY = math_huge, math_huge, -math_huge, -math_huge
    local anyOnScreen = false

    for i = 1, #parts do
        local part = parts[i]
        local cf, size = part.CFrame, part.Size
        local hx, hy, hz = size.X * 0.5, size.Y * 0.5, size.Z * 0.5

        local p1 = (cf * CFrame_new( hx,  hy,  hz)).Position
        local p2 = (cf * CFrame_new(-hx,  hy,  hz)).Position
        local p3 = (cf * CFrame_new( hx, -hy,  hz)).Position
        local p4 = (cf * CFrame_new(-hx, -hy,  hz)).Position
        local p5 = (cf * CFrame_new( hx,  hy, -hz)).Position
        local p6 = (cf * CFrame_new(-hx,  hy, -hz)).Position
        local p7 = (cf * CFrame_new( hx, -hy, -hz)).Position
        local p8 = (cf * CFrame_new(-hx, -hy, -hz)).Position

        local sp1, o1 = Camera:WorldToViewportPoint(p1)
        local sp2, o2 = Camera:WorldToViewportPoint(p2)
        local sp3, o3 = Camera:WorldToViewportPoint(p3)
        local sp4, o4 = Camera:WorldToViewportPoint(p4)
        local sp5, o5 = Camera:WorldToViewportPoint(p5)
        local sp6, o6 = Camera:WorldToViewportPoint(p6)
        local sp7, o7 = Camera:WorldToViewportPoint(p7)
        local sp8, o8 = Camera:WorldToViewportPoint(p8)

        if o1 or o2 or o3 or o4 or o5 or o6 or o7 or o8 then anyOnScreen = true end

        if sp1.Z > 0 then minX = math_min(minX, sp1.X); minY = math_min(minY, sp1.Y); maxX = math_max(maxX, sp1.X); maxY = math_max(maxY, sp1.Y) end
        if sp2.Z > 0 then minX = math_min(minX, sp2.X); minY = math_min(minY, sp2.Y); maxX = math_max(maxX, sp2.X); maxY = math_max(maxY, sp2.Y) end
        if sp3.Z > 0 then minX = math_min(minX, sp3.X); minY = math_min(minY, sp3.Y); maxX = math_max(maxX, sp3.X); maxY = math_max(maxY, sp3.Y) end
        if sp4.Z > 0 then minX = math_min(minX, sp4.X); minY = math_min(minY, sp4.Y); maxX = math_max(maxX, sp4.X); maxY = math_max(maxY, sp4.Y) end
        if sp5.Z > 0 then minX = math_min(minX, sp5.X); minY = math_min(minY, sp5.Y); maxX = math_max(maxX, sp5.X); maxY = math_max(maxY, sp5.Y) end
        if sp6.Z > 0 then minX = math_min(minX, sp6.X); minY = math_min(minY, sp6.Y); maxX = math_max(maxX, sp6.X); maxY = math_max(maxY, sp6.Y) end
        if sp7.Z > 0 then minX = math_min(minX, sp7.X); minY = math_min(minY, sp7.Y); maxX = math_max(maxX, sp7.X); maxY = math_max(maxY, sp7.Y) end
        if sp8.Z > 0 then minX = math_min(minX, sp8.X); minY = math_min(minY, sp8.Y); maxX = math_max(maxX, sp8.X); maxY = math_max(maxY, sp8.Y) end
    end

    if anyOnScreen and minX ~= math_huge then 
        return true, Vector2_new(minX, minY), Vector2_new(maxX - minX, maxY - minY) 
    end
    return false, nil, nil
end

local gradientAnimTime = 0

local function createSmoothGradient(color1, color2)
    return ColorSequence.new({ ColorSequenceKeypoint.new(0, color1), ColorSequenceKeypoint.new(1, color2) })
end

RunService.RenderStepped:Connect(function(dt)
    gradientAnimTime = gradientAnimTime + dt
    local boxConfig = EspLibLink.Drawing.Box
    local nameConfig = EspLibLink.Drawing.Name
    local distConfig = EspLibLink.Drawing.Distance
    local barsConfig = EspLibLink.Drawing.Bars

    for player, data in pairs(playerBoxes) do
        local character = player.Character
        local parts = partRegistry[player]
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChild("Humanoid")
        
        local shouldShow = true
        if boxConfig.TeamCheck and character and character:FindFirstChild("MatchTeammateHighlight") then
            shouldShow = false
        end

        if shouldShow and character and parts and #parts > 0 and root and root.Parent and not character:GetAttribute("DuelCharacterInvisible") then
            local _, rootOnScreen = Camera:WorldToViewportPoint(root.Position)
            if rootOnScreen then
                local bSuccess, pos, size = getBoundingBox(parts)
                if bSuccess then
                    local container = data.Container
                    container.Size = UDim2_new(0, math_floor(size.X), 0, math_floor(size.Y))
                    container.Position = UDim2_new(0, math_floor(pos.X), 0, math_floor(pos.Y))
                    container.Visible = true
                    
                    data.MainStroke.Enabled = boxConfig.Enabled
                    data.OuterStroke.Enabled = boxConfig.Enabled
                    data.InnerStroke.Enabled = boxConfig.Enabled

                    local topOffset = getHighestBarOffset("Top")
                    local bottomOffset = getHighestBarOffset("Bottom")
                    
                    local nameText = data.NameText
                    nameText.Visible = nameConfig and nameConfig.Enabled or false
                    if nameText.Visible then
                        if nameConfig.Color then nameText.TextColor3 = nameConfig.Color end
                        nameText.Position = UDim2_new(0.5, 0, 0, (topOffset > 0 and (-3 - topOffset) or -3))
                    end
                    
                    local distanceText = data.DistanceText
                    distanceText.Visible = distConfig and distConfig.Enabled or false
                    if distanceText.Visible then
                        if distConfig.Color then distanceText.TextColor3 = distConfig.Color end
                        distanceText.Position = UDim2_new(0.5, 0, 1, (bottomOffset > 0 and (2 + bottomOffset) or 2))
                        local localChar = LocalPlayer.Character
                        local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
                        if localRoot then 
                            distanceText.Text = math_floor((localRoot.Position - root.Position).Magnitude) .. "m" 
                        end
                    end
                    
                    if boxConfig.Enabled then
                        local gradientConfig = boxConfig.Gradient
                        if gradientConfig.Enabled then
                            local strokeGradient = data.MainStroke:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
                            strokeGradient.Color = createSmoothGradient(gradientConfig.Color1, gradientConfig.Color2)
                            strokeGradient.Rotation = gradientConfig.Animated and ((gradientAnimTime * gradientConfig.Speed * 360) % 360) or 45
                            if not strokeGradient.Parent then strokeGradient.Parent = data.MainStroke end
                            data.MainStroke.Color = Color3_fromRGB(255, 255, 255)
                        else
                            local grad = data.MainStroke:FindFirstChildOfClass("UIGradient")
                            if grad then grad:Destroy() end
                            data.MainStroke.Color = Color3_fromRGB(255, 255, 255)
                        end
                        
                        local glowConfig = boxConfig.Glow
                        data.GlowImage.Visible = glowConfig.Enabled
                        if glowConfig.Enabled then
                            data.GlowImage.ImageColor3 = glowConfig.Color
                            data.GlowImage.ImageTransparency = glowConfig.Transparency 
                        end
                    else
                        data.GlowImage.Visible = false
                    end
                    
                    if not displayedValues[player] then displayedValues[player] = {} end
                    
                    for barName, barConfig in pairs(barsConfig or {}) do
                        local cachedBar = data.Bars[barName]
                        if cachedBar then
                            local bar = cachedBar.Bar
                            bar.Visible = barConfig.Enabled
                            if barConfig.Enabled then
                                local t = barConfig.Thickness or 2
                                local off = barConfig.Offset or 5
                                local side = barConfig.Side or "Left"
                                
                                if side == "Left" then
                                    bar.Size = UDim2_new(0, t, 1, 2)
                                    bar.Position = UDim2_new(0, -off - t, 0, -1)
                                elseif side == "Right" then
                                    bar.Size = UDim2_new(0, t, 1, 2)
                                    bar.Position = UDim2_new(1, off, 0, -1)
                                elseif side == "Top" then
                                    bar.Size = UDim2_new(1, 2, 0, t)
                                    bar.Position = UDim2_new(0, -1, 0, -off - t)
                                elseif side == "Bottom" then
                                    bar.Size = UDim2_new(1, 2, 0, t)
                                    bar.Position = UDim2_new(0, -1, 1, off)
                                end
                                
                                local currentVal = barConfig.Values and barConfig.Values.Current or 100
                                local maxVal = barConfig.Values and barConfig.Values.Max or 100
                                local lastVal = bar:GetAttribute("LastValue")
                                
                                if not displayedValues[player][barConfig.Name] then 
                                    displayedValues[player][barConfig.Name] = currentVal 
                                else 
                                    displayedValues[player][barConfig.Name] = displayedValues[player][barConfig.Name] + (currentVal - displayedValues[player][barConfig.Name]) * math_clamp(dt * 15, 0, 1) 
                                end
                                
                                local currentDisplayVal = displayedValues[player][barConfig.Name]
                                local ratio = math_clamp(currentVal / maxVal, 0, 1)
                                
                                local gradCfg = barConfig.Gradient
                                local textColor = Color3_fromRGB(255, 255, 255)
                                local fill = cachedBar.Fill
                                local valueText = cachedBar.ValueText
                                
                                if type(gradCfg) == "table" and gradCfg.Enabled then
                                    textColor = evaluateCustomGradientColor(gradCfg, ratio)
                                    if fill then
                                        fill.BackgroundColor3 = Color3_fromRGB(255, 255, 255)
                                        local uig = cachedBar.Gradient or fill:FindFirstChildOfClass("UIGradient")
                                        if not uig then
                                            uig = Instance.new("UIGradient", fill)
                                            uig.Name = "Grad"
                                            cachedBar.Gradient = uig
                                        end
                                        
                                        local isHorizontal = (side == "Top" or side == "Bottom")
                                        uig.Rotation = isHorizontal and 0 or 90
                                        uig.Color = buildSeamlessColorSequence(gradCfg)
                                        uig.Offset = Vector2_new(0, 0)
                                    end
                                else
                                    if fill then
                                        fill.BackgroundColor3 = barConfig.Color or Color3_fromRGB(255, 255, 255)
                                        if cachedBar.Gradient then 
                                            cachedBar.Gradient:Destroy() 
                                            cachedBar.Gradient = nil 
                                        end
                                    end
                                    textColor = barConfig.Color or Color3_fromRGB(255, 255, 255)
                                end
                                
                                if fill and valueText then
                                    if currentVal ~= lastVal then
                                        bar:SetAttribute("LastValue", currentVal)
                                        local targetSize, targetPos
                                        if side == "Left" or side == "Right" then
                                            if barConfig.Inverted then
                                                targetSize = UDim2_new(1, 0, ratio, 0)
                                                targetPos = UDim2_new(0, 0, 0, 0)
                                            else
                                                targetSize = UDim2_new(1, 0, ratio, 0)
                                                targetPos = UDim2_new(0, 0, 1 - ratio, 0)
                                            end
                                        else
                                            if barConfig.Inverted then
                                                targetSize = UDim2_new(ratio, 0, 1, 0)
                                                targetPos = UDim2_new(1 - ratio, 0, 0, 0)
                                            else
                                                targetSize = UDim2_new(ratio, 0, 1, 0)
                                                targetPos = UDim2_new(0, 0, 0, 0)
                                            end
                                        end
                                        TweenService:Create(fill, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = targetSize, Position = targetPos }):Play()
                                    end
                                    
                                    if barConfig.ShowText then
                                        local format = barConfig.TextFormat or "Value"
                                        local textStr = tostring(math_floor(currentDisplayVal + 0.5))
                                        if format == "Percentage" then
                                            textStr = math_floor((currentDisplayVal / maxVal) * 100 + 0.5) .. "%"
                                        elseif format == "Fraction" then
                                            textStr = math_floor(currentDisplayVal + 0.5) .. "/" .. math_floor(maxVal + 0.5)
                                        end
                                        valueText.Text = textStr
                                        
                                        valueText.Visible = barConfig.HideWhenMax and (currentVal < maxVal) or true
                                        valueText.TextColor3 = textColor
                                        
                                        if side == "Left" then
                                            valueText.AnchorPoint = Vector2_new(1, 0)
                                            valueText.Position = UDim2_new(0, -3, 0, math_floor(bar.AbsoluteSize.Y * (1 - ratio)) - 2)
                                        elseif side == "Right" then
                                            valueText.AnchorPoint = Vector2_new(0, 0)
                                            valueText.Position = UDim2_new(1, 3, 0, math_floor(bar.AbsoluteSize.Y * (1 - ratio)) - 2)
                                        else
                                            valueText.AnchorPoint = Vector2_new(0.5, 1)
                                            valueText.Position = UDim2_new(ratio, 0, 0, -2)
                                        end
                                    else
                                        valueText.Visible = false
                                    end
                                end
                            end
                        end
                    end
                    continue
                end
            end
        end
        data.Container.Visible = false
        displayedValues[player] = nil
    end
end)

return EspLibLink
