local function createElement(className, properties, parent)
    local instance = Instance.new(className)
    for prop, value in pairs(properties) do instance[prop] = value end
    if parent then instance.Parent = parent end
    return instance
end

local function createStroke(color, parent)
    return Instance.new("UIStroke", parent, { Color = color, Thickness = 1, LineJoinMode = Enum.LineJoinMode.Miter })
end

